{
  "name": "@bookarium/codex-connector",
  "version": "0.1.0",
  "description": "Local, loopback-only Bookarium bridge for a ChatGPT-authenticated Codex CLI",
  "type": "module",
  "bin": {
    "bookarium-codex-connector": "bin/bookarium-codex-connector.mjs"
  },
  "exports": "./src/index.mjs",
  "files": [
    "bin/",
    "docs/windows-startup.md",
    "src/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "SUPPORT.md"
  ],
  "scripts": {
    "check:secrets": "node ./scripts/repository-checks.mjs secrets",
    "lint": "node ./scripts/repository-checks.mjs source",
    "start": "node ./bin/bookarium-codex-connector.mjs serve",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "pack:check": "npm pack --dry-run --json | node ./scripts/repository-checks.mjs pack",
    "smoke:packed": "node --test test/smoke/packed-tarball-windows.test.mjs"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "keywords": [
    "bookarium",
    "codex",
    "education"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jojo-open-dev/bookarium-codex-connector.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
